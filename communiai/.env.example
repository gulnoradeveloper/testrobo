# ---------------------------------------------------------------- CommuniAI backend configuration
# Copy to .env (docker compose) or backend/.env (local run) and fill in. Never commit real secrets.

APP_ENV=development            # development | production
LOG_LEVEL=INFO

# PostgreSQL (SQLAlchemy URL, psycopg3 driver). Leave commented for the quick start (start-backend.*),
# which then uses a local SQLite file. docker-compose sets this automatically.
# DATABASE_URL=postgresql+psycopg://communiai:communiai@localhost:5432/communiai
POSTGRES_PASSWORD=communiai    # used by docker-compose for the postgres container

# JWT signing secret: long random string, e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`
# REQUIRED in production. The quick start generates one automatically if left commented.
# JWT_SECRET=

# AI provider. Implemented: anthropic. Set AI_PROVIDER=disabled to run without AI (AI features report
# "not configured"; no fake results are produced).
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=120
AI_EFFORT=medium               # low | medium | high | xhigh | max

# Uploads and storage
MAX_UPLOAD_SIZE_MB=20
FILE_STORAGE_BACKEND=local     # local | s3
LOCAL_STORAGE_DIR=./storage
STORAGE_BUCKET=                # for s3
S3_ENDPOINT_URL=               # e.g. https://s3.amazonaws.com or a MinIO URL
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Comma-separated list of browser origins allowed by CORS (the mobile app does not need CORS)
CORS_ALLOWED_ORIGINS=

# Password reset e-mail (SMTP). If SMTP_HOST is empty the app shows "email service not configured".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Rate limits (requests per minute)
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_PER_MINUTE=20

RUBRIC_VERSION=1.0

# Public domain for HTTPS via Caddy (docker compose --profile https)
DOMAIN=api.example.uz
