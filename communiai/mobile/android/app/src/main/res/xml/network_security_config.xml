<?xml version="1.0" encoding="utf-8"?>
<!--
  Production: the API must be served over HTTPS (cleartext is blocked by default).
  Cleartext HTTP is allowed only for the Android emulator host and localhost.
  For a backend on the local network build with -PallowCleartext=true (see docs/BUILD_APK.md).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
