# Nusxa oling: cp .env.example .env  va qiymatlarni o'zgartiring
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,begoyim.uz
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,https://begoyim.uz
# HTTPS sertifikati sozlanmaguncha 0 qoldiring
DJANGO_SECURE_SSL_REDIRECT=0
POSTGRES_DB=begoyim
POSTGRES_USER=begoyim
POSTGRES_PASSWORD=change-me
# Demo ma'lumotlar bilan ishga tushirish uchun bo'sh qiymat bering: SEED_ARGS=
SEED_ARGS=--reference-only
