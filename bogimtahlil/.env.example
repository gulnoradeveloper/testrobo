# Nusxa oling:  cp .env.example .env
# Bu faylda maxfiy kalitlar yo‘q; .env fayli git’ga qo‘shilmaydi.

BT_ENVIRONMENT=production
# Model fayli (Docker’da artifacts/ katalogi /models sifatida ulanadi)
# BT_MODEL_PATH=artifacts/model.pt
# Ko‘rsatilsa, yuklashda checkpoint SHA-256 qiymati tekshiriladi (artifacts/model.pt.sha256)
BT_MODEL_SHA256=
# FAQAT avtomatik testlar uchun. Ishchi muhitda doimo false bo‘lsin.
BT_ALLOW_UNTRAINED_MODEL=false
# auto | cpu | cuda
BT_DEVICE=auto

BT_MAX_UPLOAD_MB=20
BT_RETENTION_HOURS=24
BT_RATE_LIMIT_ANALYSES_PER_MINUTE=10
BT_RATE_LIMIT_REQUESTS_PER_MINUTE=240

# Lokal ishlab chiqishda Vite manzili; Docker’da interfeys bir xil domenda ishlaydi
BT_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Internetga joylashtirilganda (HTTPS teskari proksi ortida) quyidagilarni true qiling
BT_SESSION_COOKIE_SECURE=false
BT_FORCE_HTTPS=false
BT_TRUST_PROXY_HEADERS=false

BT_HTTP_PORT=8080
